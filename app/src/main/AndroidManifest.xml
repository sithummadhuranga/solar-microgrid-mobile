<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SolarMicrogrid">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ReserveSlotActivity" android:exported="false" />
        <activity android:name=".ModifyReservationActivity" android:exported="false" />
        <activity android:name=".CancelReservationActivity" android:exported="false" />
        <activity android:name=".ReservationSummaryActivity" android:exported="false" />
        <activity android:name=".ReservationQrActivity" android:exported="false" />

    </application>

</manifest>
